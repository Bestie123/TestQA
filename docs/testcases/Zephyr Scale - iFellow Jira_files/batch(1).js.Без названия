            if ($image.length) {
                var imageDimensions = FileViewerFunctions.getImageDimensions($image.get(0));

                var viewportWidth = $el.width();
                var viewportHeight = $el.height();

                if ((viewportWidth / imageDimensions.imageWidth) < (viewportHeight / imageDimensions.imageHeight)
                    && (imageDimensions.imageWidth > viewportWidth)) {
                    FileViewerFunctions.zoomWidth($el, $image, imageDimensions);
                }
            }
        },

        zoomWidth: function ($el, $image, imageDimensions) {
            var viewportWidth = $el.width();
