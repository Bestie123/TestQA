            return this.delegate.getFileID();
        },

        getAttachmentId: function () {
            return this.delegate.attachmentId;
        },

        monitorUpload: function (promise) {
            promise.progress(this.setProgress.bind(this));
            promise.fail(this.setFailed.bind(this));
        },

        setProgress: function (state) {
            this.progress = state;
            this.updateProgress();
        },

        setFailed: function (message, isPrecondition) {
            if (typeof isPrecondition === 'boolean') {
                this.$node.addClass('UploadProgressBar_uploadFailed');
            }
            var progressBar = this.$node.find('.upload-progress-bar__progress-bar');
            progressBar.find('.upload-progress-bar__bar').css('width', '100%');
