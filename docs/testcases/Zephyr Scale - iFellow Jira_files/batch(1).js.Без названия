                    category: category,
                    width: width,
                    height: height
                }));

                $dropZoneItem.on('dragenter dragover', this.onDragOver.bind(this));
                $dropZoneItem.on('dragleave', _.debounce(this.onDragLeave.bind(this), 50));
                $dropZoneItem.on('drop', (function (event) {
