            $textarea.keyup(function(e) {
                if ($.inArray(e.which, [13, 38, 40]) >= 0) {
                    return;
                }

                var token = t.pattern.token($textarea[0]);

                if (token.value.length > 0) {
                    t.showSuggestions($textarea, token);
                } else {
                    t.removeSuggestions();
                }
            });
        },

        bindSuggestionEvent: function($textarea, suggestions) {
            var t = this;

            suggestions.click(function() {
                var $suggestion = $('.smart-attach-suggestion', this);
                if ($suggestion.length > 0) {
                    var text = $suggestion.attr('data-mail');
                    t.pattern.replace($textarea[0], text);
                    t.removeSuggestions();
                    $textarea.focus();
                }
                return false;
            });

            suggestions.hover(function() {
                $('.smart-attach-suggestion-active').removeClass('smart-attach-suggestion-active');
                $(this).addClass('smart-attach-suggestion-active');
