                .on('focus.sa-reply-show', '.sa-reply-input', FVI.showReplyControls)
                .on('click.sa-reply-hide', '.sa-reply-cancel', FVI.hideReplyControls)
                .on('click.sa-change-file-rev', '.sa-revision-item', FVI.changeFileRevision);

            $(document).on('keydown.sa-textarea-key-lr-arrows', '#sa-comments textarea', FVI.catchFVKeydownLRArrowEvents);
        },

        bindThreadEvents: function () {
            $(document)
                .on('click.sa-create-thread', '#sa-create-thread', FVI.createThread)
                .on('keydown.sa-thread-submit', '#sa-create-thread-wrapper textarea', FVI.submitThread)
                .on('click.sa-make-active', '#sa-threads-container .sa-thread-wrapper', FVI.makeThreadActiveByEvent)
                .on('click.sa-unmake-active', '#sa-threads-container', FVI.unmakeThreadActiveByEvent)
                .on('mousedown.sa-thread-remove', '.sa-thread-delete-menu', FVI.showDeleteThreadDialog);
            FVI.bindThreadArrowsNavigation();
        },

        bindCommentEvents: function () {
            $(document).on('click.sa-reply-add', '.sa-reply-add', FVI.addReply)
                .on('keydown.sa-reply-submit', '.sa-reply-textarea', FVI.ctrlEnterSubmitReply)
                .on('click.sa-comm-remove', '.sa-comment-delete-dialog', FVI.showDeleteCommentDialog)
                .on('click.sa-comm-edit', '.sa-comment-edit', FVI.editComment)
                .on('click.sa-comm-edit-cancel', '.sa-comment-edit-cancel', FVI.editCommentCancel)
                .on('click.sa-comm-edit-save', '.sa-comment-edit-save', FVI.editCommentSave)
                .on('keydown.sa-comm-edit-submit', '.sa-edit-comment-textarea', FVI.submitEditComment)
                .on('keyup.sa-grayed-out-button', '.sa-reply-textarea, .sa-edit-comment-textarea, #sa-create-thread-wrapper textarea', FVI.checkOnEmptyTextareaAndEnableButtons);
        },

        bindMentionsEvent: function () {
            $(document)
                .on('focus.sa-textarea', '#sa-comments textarea', AutocompleteFileViewer.bindTextAreaAutocomplete)
                .on('blur.sa-textarea', '#sa-comments textarea', AutocompleteFileViewer.removeSuggestionOnBlur);
        },

        bindCheckFVControls: function (attachmentId) {
            waitForElement('#cp-title-container', function (selector, context) {
                observeDOMTitleUpdated(context.get(0), function () {
                    FVI.resetControlsFlag();
                    FVI.checkFVControls(attachmentId);
                });
            }, 200);
        },

        initFileViewer: function (context) {
            if ($('#ghx-tab-attachments').length === 0) {
                if (!FVI.isFVEnabled()) {
                    FakeFileViewer.init(context);
                } else {
                    FakeFileViewer.bindEvents(context, false);
                }
            }
        },

        initButtons: function (attachmentId) {
            FVI.addButtonComments(attachmentId);
            FVI.addButtonRevisions();
            FVI.addButtonOpenInBrowser();
        },

        toggleSidebar: function () {
            var t = FVI;
            var sidebar = $('#sa-comments');
            if (sidebar.is(":visible")) {
                t.hideSidebar();
            } else {
                t.showSidebar(FVI.getOpenedAttachId());
            }
        },

        hideSidebar: function (e) {
            FVI.isActiveSidebar = false;
            $('#sa-comments').hide();
            $('#cp-file-body').removeClass('fv-cp-viewer-layer');
            $('#cp-nav-right').removeClass('fv-cp-nav-right');
            $('#inline-dialog-sa-file-revision-dialog').remove();
            resizeImageContainer();

            if (e && e.currentTarget.id === "cp-control-panel-close" && $(e.currentTarget).is(":visible")) {
                var newEvent = jQuery.Event("keydown");
                newEvent.which = 27;
                $(document).trigger(newEvent);
            }
        },

        showSidebar: function (attachmentId) {
            FVI.isActiveSidebar = true;
            $('#sa-comments').show();
            $('#cp-file-body').addClass('fv-cp-viewer-layer');
            $('#cp-nav-right').addClass('fv-cp-nav-right');
            FVI.loadComments(attachmentId);
            FVI.resizeSidebar();
            resizeImageContainer();
        },

        resizeSidebar: function () {
            var fileBody = $('#cp-file-body');
            var sidebar = $('#sa-comments');
            if (fileBody.hasClass('meta-banner')) {
                sidebar.addClass('fv-meta-banner');
            } else {
                sidebar.removeClass('fv-meta-banner');
            }
            if (fileBody.hasClass('short')) {
                sidebar.addClass('fv-short');
            } else {
                sidebar.removeClass('fv-short');
            }
        },

        checkFVControls: function (attachmentId) {
            if (!$(this).find('#fv-comments').length && !FVI.isControlsInit) {
                FVI.isControlsInit = true;
                FVI.initButtons(attachmentId);
            }
        },

        addButtonComments: function (attachmentId) {
            waitForElement('#cp-file-controls', function (selector, context) {
                var sidebar = $('#sa-comments');
                var shortSidebar = $('.fv-cp-viewer-layer');
                var isInitCommentButton = $('#fv-comments').length > 0;

                if (!isInitCommentButton) {
                    $(context).find('#cp-control-panel-download')
                        .parent()
                        .after(FVITemplates.buttonComments({'attachId': attachmentId}));
                }
                if (!sidebar.length) {
                    $('#cp-body').prepend(FVITemplates.sidebar(FVI.getLoggedInUser()));
                }

                if (FVI.isActiveSidebar && !sidebar.is(":visible")) {
                    FVI.showSidebar(attachmentId);
                } else {
                    FVI.isActiveSidebar = sidebar.is(":visible");
                    if (shortSidebar.length && !FVI.isActiveSidebar) {
                        shortSidebar.removeClass('fv-cp-viewer-layer');
                    }
                    if (FVI.isActiveSidebar) {
                        FVI.reloadComments(attachmentId);
                    }
                }

                $('#cp-control-panel-close')
                    .off('click.sa')
                    .on('click.sa', resetObserver);

                FVI.resizeSidebar();
                FVI.bindCheckFVControls(attachmentId);
            }, 200);
        },

        addButtonRevisions: function () {
            waitForElement('#cp-title-container', function (selector, context) {
                $('#sa-file-revisions').remove();
                $('#sa-file-revisions-container').remove();

                var attachId = FVI.getOpenedAttachId();
                var title = '';
                var ids = [];

                $.each(FVI.documents, function () {
                    var index = this.attachmentIds.indexOf(attachId);
                    if (index >= 0) {
                        index++;
                        title = AJS.format("v.{0} [Current]", index);
                        ids = this.attachmentIds;
                        return false;
                    }
                });

                if (ids.length) {
                    $(context).after(FVITemplates.buttonRevisions({'title': title}));
                    FVI.initRevisionsDialog(ids, attachId);
                }
            }, 200);
        },

        addButtonOpenInBrowser: function () {
            waitForElement('#cp-error-message a.download-button', function (selector, context) {
                $('#sa-open-in-browser').remove();
                context.after(FVITemplates.buttonOpenInBrowser({'url': context.attr('href')}));
            }, 200);
        },

        resetControlsFlag: function () {
            FVI.isControlsInit = false;
        },

        addFVLinkParams: function (link, id, name, type) {
            if (!link.is("a")) {
                link = link.find('a');
            }
            link.attr('file-preview-id', id);
            link.attr('file-preview-title', name);
            link.attr('file-preview-type', type);
        },

        appendComments: function (data, isActiveLastThread) {
            $('#sa-comments').data('showNotificationInfoIcon', data.showNotificationInfoIcon);
            var threadsContainer = $('#sa-threads-container');
            threadsContainer.find('.sa-no-comments').remove();

            $.each(data.comments, function (i, commentEntity) {
                var thread = threadsContainer.find('#sa-comment-thread-' + commentEntity.threadId + ' .sa-thread');
                if (!thread.length) {
                    commentEntity["canDeleteAll"] = data.canDeleteAll;
                    FVI.appendThread(threadsContainer, commentEntity);
                }
                FVI.appendComment(commentEntity);
            });

            if (data.comments.length !== 0) {
                if (isActiveLastThread) {
                    threadsContainer.find('.sa-thread-wrapper').first().trigger('click.sa-make-active');
                }
                if (threadsContainer[0] !== undefined) {
                    threadsContainer.scrollTop(0);
                }
            } else {
                threadsContainer.append(FVITemplates.commentsNotFound());
            }
            FVI.drawThreadPreviews();
            FVI.redrawThreadsNavigation();

            var createThreadPanel = $('#sa-create-thread-wrapper');
            if (createThreadPanel.is(":visible")){
                FVI.initCommentHelpIcon(createThreadPanel.find('.sa-fv-controls'));
            }
        },

        appendComment: function (commentEntity) {
            var thread = $('#sa-comment-thread-' + commentEntity.threadId + ' .sa-thread');
            var comment = thread.find("[data-comment-id='" + commentEntity.id + "']");
            if (!comment.length) {
                commentEntity = FVI.removeFVLinkFromRenderedComment(commentEntity);
                var threadComments = thread.find('.sa-comment');
                var newComment = FVITemplates.comment(commentEntity);

                var isInserted = false;
                threadComments.each(function (i, elem) {
                    var currentComment = $(elem);
                    if (currentComment.data('commentId') > commentEntity.id) {
                        currentComment.before(newComment);
                        isInserted = true;
                        return false;
                    }
                });
                if (!isInserted) {
                    thread.append(newComment);
                }
            }
        },

        removeFVLinkFromRenderedComment: function (commentEntity) {
            var commentBody = $(commentEntity.renderedContent);
            commentBody.find('a[file-preview-id]').each(function (i, link) {
                commentBody.find(link).replaceWith(link.innerHTML);
            });
            commentEntity.renderedContent = $('<div>').append(commentBody.clone()).html();
            return commentEntity;
        },

        appendThread: function (threadsContainer, commentEntity) {
            var threadAppended = false;
            commentEntity["canAddComments"] = FVI.isCanAddComments();

            threadsContainer.find('.sa-thread-wrapper').each(function () {
                if ($(this).data('threadId') < commentEntity.threadId) {
                    $(this).before(FVITemplates.thread(commentEntity));
                    threadAppended = true;
                    return false;
                }
            });

            if (!threadAppended) {
                threadsContainer.append(FVITemplates.thread(commentEntity));
            }
        },

        loadComments: function (attachmentId) {
            $.ajax({
                type: "GET",
                data: {
                    'attachId': attachmentId
                },
                url: AJS.params.baseURL + '/rest/attach-cat/1.0/comment',
                success: function (data) {
                    FVI.appendComments(data, false);
                },
            });
        },

        reloadComments: function (attachmentId) {
            $('#sa-threads-container').empty();
            FVI.loadComments(attachmentId);
        },

        clearAndHideCreateThread: function () {
            $('#sa-create-thread-wrapper').find('textarea').val('').blur();
            FVI.hideCreateThread();
            return false;
        },

        submitThread: function (e) {
            if (e.ctrlKey && e.keyCode == 13) {
                return FVI.createThread();
            }
        },

        submitEditComment: function (e) {
            if (e.ctrlKey && e.keyCode == 13) {
                return FVI.editCommentSave(e);
            }
        },

        ctrlEnterSubmitReply: function (e) {
            if (e.ctrlKey && e.keyCode == 13) {
                return FVI.addReply(e);
            }
        },

        catchFVKeydownLRArrowEvents: function (e) {
            if ((e.keyCode === 37 || e.keyCode === 39)) {
                if ($('#sa-comments').find('textarea:focus')) {
                    e.stopPropagation();
                    e.stopImmediatePropagation();
                } else {
                    FVI.resetControlsFlag();
                }
            }
        },

        createThread: function () {
            var createThreadPanel = $('#sa-create-thread-wrapper');
            var textarea = createThreadPanel.find('textarea');
            var content = textarea.val().trim();
            var attachId = FVI.getOpenedAttachId();
            var attachmentName = FVI.getAttachmentName(attachId);

            if (content !== '') {
                FVI.showSpinner(createThreadPanel, textarea);
                $.ajax({
                    type: "POST",
                    data: {
                        'attachId': attachId,
                        'content': content
                    },
                    url: AJS.params.baseURL + '/rest/attach-cat/1.0/comment/thread',
                    success: function (data) {
                        SmartAttachmentsAnalytics.event('commentThreadAdded', [attachmentName]);
                        FVI.hideSpinner(createThreadPanel, textarea);
                        FVI.clearAndHideCreateThread();
                        FVI.appendComments(data, true);
                        FVI.redrawThreadsNavigation();
                        FVI.makeIconCommentForAttachment();
                    },
                    error: function () {
                        FVI.hideSpinner(createThreadPanel, textarea);
                    }
                });
            } else {
                textarea.focus();
            }

            return false;
        },

        showDeleteCommentDialog: function (e) {
            var comment = $(e.currentTarget).closest('.sa-comment');

            var dialog = new AJS.Dialog({
                width: 500,
                height: 170,
                id: "sa-comment-delete-dialog",
                closeOnOutsideClick: true
            });

            dialog.addHeader("Delete Comment");
            dialog.addPanel('panel', FVITemplates.deleteCommentDialog(), 'sa-comment-delete-dialog-panel');

            dialog.addButton("Delete", function () {
                FVI.deleteComment(comment, dialog);
            }, "sa-comment-delete");

            dialog.addLink("Cancel", function (dialog) {
                dialog.remove();
            }, '#');

            dialog.show();
            return false;
        },

        deleteComment: function (comment, dialog) {
            var threadsContainer = $('#sa-threads-container');
            var thread = comment.parents('.sa-thread-wrapper');
            var attachId = thread.data('attachmentId');
            var commentId = comment.data('commentId');
            var attachmentName = FVI.getAttachmentName(attachId);

            $.ajax({
                type: "DELETE",
                data: {
                    'commentId': commentId
                },
                url: AJS.params.baseURL + '/rest/attach-cat/1.0/comment',
                success: function () {
                    SmartAttachmentsAnalytics.event('commentDeleted', [attachmentName]);

                    comment.remove();
                    dialog.remove();
                    if (thread.find('.sa-thread').is(':empty')) {
                        thread.remove();
                        FVI.redrawThreadsNavigation();
                        FVI.removeIconCommentForAttachment(attachId);
                    }
                    if (threadsContainer.is(':empty')) {
                        threadsContainer.append(FVITemplates.commentsNotFound());
                    }
                    FVI.drawThreadPreviews();
                },
                error: function () {
                    dialog.remove();
                }
            });
        },

        showDeleteThreadDialog: function () {
            var dialog = new AJS.Dialog({
                width: 500,
                height: 170,
                id: "sa-thread-delete-dialog",
                closeOnOutsideClick: true
            });

            dialog.addHeader("Delete thread");
            dialog.addPanel('panel', FVITemplates.deleteThreadDialog(), 'sa-thread-delete-dialog-panel');

            dialog.addButton("Delete", function () {
                FVI.deleteThread(dialog);
            }, "sa-thread-delete");

            dialog.addLink("Cancel", function (dialog) {
                dialog.remove();
            }, '#');

            dialog.show();
            return false;
        },

        deleteThread: function (dialog) {
            var threadsContainer = $('#sa-threads-container');
            var thread = threadsContainer.find('.sa-active-thread');
            var attachId = thread.data('attachmentId');
            var attachmentName = FVI.getAttachmentName(attachId);

            $.ajax({
                type: "DELETE",
                data: {
                    'threadId': thread.data('threadId'),
                    'attachId': FVI.getOpenedAttachId()
                },
                url: AJS.params.baseURL + '/rest/attach-cat/1.0/comment/thread',
                success: function () {
                    SmartAttachmentsAnalytics.event('commentThreadDeleted', [attachmentName]);
                    thread.remove();
                    dialog.remove();
                    if (threadsContainer.is(':empty')) {
                        threadsContainer.append(FVITemplates.commentsNotFound());
                    }
                    FVI.redrawThreadsNavigation();
                    FVI.removeIconCommentForAttachment(attachId);
                },
                error: function () {
                    dialog.remove();
                }
            });
        },

        editComment: function (e) {
            var comment = $(e.currentTarget).closest('.sa-comment');
            var textarea = comment.find('.sa-edit-comment-textarea');
            comment.find('.sa-comment-edit-body').show();
            comment.find('.sa-comment-body').hide();
            textarea.autosize();
            textarea.focus();
            FVI.initCommentHelpIcon(comment.find('.sa-fv-controls'));
            return false;
        },

        editCommentSave: function (e) {
            var attachId = FVI.getOpenedAttachId();
            var attachmentName = FVI.getAttachmentName(attachId);
            var comment = $(e.currentTarget).closest('.sa-comment');
            var textarea = comment.find('.sa-edit-comment-textarea');
            FVI.showSpinner(comment, textarea);

            $.ajax({
                type: 'PUT',
                data: {
                    'commentId': comment.data('commentId'),
                    'content': textarea.val()
                },
                url: AJS.params.baseURL + '/rest/attach-cat/1.0/comment',
                success: function (updatedComment) {
                    SmartAttachmentsAnalytics.event('commentEdited', [attachmentName]);
                    FVI.hideSpinner(comment, textarea);
                    if (updatedComment) {
                        updatedComment = FVI.removeFVLinkFromRenderedComment(updatedComment);
                        comment.replaceWith(FVITemplates.comment(updatedComment));
                        FVI.drawThreadPreviews();
                    }
                },
                error: function (data) {
                    console.error('Can not save the comment ' + data);
                    FVI.editCommentCancel(e);
                    FVI.hideSpinner(comment, textarea);
                }
            });
            return false;
        },

        editCommentCancel: function (e) {
            var comment = $(e.currentTarget).closest('.sa-comment');
            var textarea = comment.find('textarea');
            comment.find('.sa-comment-body').show();
            comment.find('.sa-comment-edit-body').hide();
            comment.find('.sa-info-icon-wrapper').remove();
            textarea.val(textarea.data('originalContent'));
            textarea.parents('form.aui').find('button.aui-button-primary').attr('disabled', true);
            return false;
        },

        showCreateThread: function () {
            var createThreadPanel = $('#sa-create-thread-wrapper');
            var threadsContainer = $('#sa-threads-container');
            var shortPanelHeight = createThreadPanel.height();
            var containerScrollTop = threadsContainer.scrollTop();

            $(this).hide();
            createThreadPanel.addClass('input-wrapper-full').find('form').show();
            createThreadPanel.find('textarea').focus();
            threadsContainer.addClass('threads-container-short');

            var largePanelHeight = createThreadPanel.height();
            threadsContainer.scrollTop(containerScrollTop + (largePanelHeight - shortPanelHeight));

            FVI.initCommentHelpIcon(createThreadPanel.find('.sa-fv-controls'));
        },

        hideCreateThread: function () {
            var createThreadPanel = $('#sa-create-thread-wrapper');
            var threadsContainer = $('#sa-threads-container');
            var largePanelHeight = createThreadPanel.height();
            var containerScrollTop = threadsContainer.scrollTop();
            var textarea = createThreadPanel.find('.sa-textarea-create-thread');

            $('#sa-new-thread-show').show();
            createThreadPanel.removeClass('input-wrapper-full').find('form').hide();
            threadsContainer.removeClass('threads-container-short');
            createThreadPanel.find('.sa-info-icon-wrapper').remove();
            createThreadPanel.find('button.aui-button-primary').attr('disabled', textarea.val() === '');

            var shortPanelHeight = createThreadPanel.height();
            threadsContainer.scrollTop(containerScrollTop - largePanelHeight + shortPanelHeight);
        },

        addReply: function (e) {
            var thread = e ? $(e.currentTarget).closest('.sa-thread-wrapper') : $(this).closest('.sa-thread-wrapper');
            var textarea = thread.find('.sa-reply textarea');
            var threadId = thread.data('threadId');
            var content = textarea.val();
            var form = thread.find('.sa-reply-form');
            var attachId = thread.data('attachmentId');
            var attachmentName = FVI.getAttachmentName(attachId);

            if (content.trim() !== '') {
                FVI.showSpinner(form, textarea);
                $.ajax({
                    type: "POST",
                    data: {
                        'threadId': threadId,
                        'attachId': attachId,
                        'content': content
                    },
                    url: AJS.params.baseURL + '/rest/attach-cat/1.0/comment/reply',
                    success: function (data) {
                        SmartAttachmentsAnalytics.event('newCommentAdded', [attachmentName]);
                        FVI.appendComment(data);
                        FVI.hideReplyControlsByThread(thread, true);
                        FVI.hideSpinner(form, textarea);
                        FVI.drawThreadPreviews();
                    },
                    error: function () {
                        FVI.hideSpinner(form, textarea);
                    }
                });
            } else {
                textarea.focus();
            }
            return false;
        },

        showReplyControls: function () {
            var thread = $(this).closest('.sa-thread-wrapper');
            var textarea = thread.find('.sa-reply-textarea');
            textarea.autosize();
            thread.find('.sa-reply-short').removeClass('sa-reply-short');
            textarea.css('height', '70px').show();
            thread.find('.sa-reply-controls').show();
            thread.find('.sa-reply-input').hide();
            FVI.initCommentHelpIcon(thread.find('.sa-reply-form .sa-fv-controls'));
            FVI.scrollReplyControls(thread);
            textarea.focus();
        },

        hideReplyControls: function () {
            var thread = $(this).closest('.sa-thread-wrapper');
            FVI.hideReplyControlsByThread(thread, true);
            return false;
        },

        hideReplyControlsByThread: function (thread, isErase) {
            var textarea = thread.find('.sa-reply-textarea');
            var value = isErase ? '' : textarea.val();

            if (value !== undefined && value.trim() === '') {
                textarea.val('').hide();
                thread.find('.sa-reply').addClass('sa-reply-short');
                thread.find('.sa-reply-controls').hide();
                thread.find('.sa-reply-input').show();
                thread.find('.sa-info-icon-wrapper').remove();
                textarea.parents('form.aui').find('button.aui-button-primary').attr('disabled', true);
            }
        },

        scrollReplyControls: function (thread) {
            var container = thread.parent();
            var replyForm = thread.find('.sa-reply-form');

            var createThreadPositionTop = $('#sa-create-thread-wrapper').position().top;
            var replyFormScrollHeight = replyForm.get(0).scrollHeight;
            var distance = createThreadPositionTop - replyForm.position().top;

            if (distance < replyFormScrollHeight) {
                container.animate({scrollTop: replyFormScrollHeight - distance + container.scrollTop()}, "fast");
            }
        },

        makeThreadActiveByEvent: function (e) {
            var thread = $(e.currentTarget);
            if (!thread.hasClass('sa-active-thread')) {
                $('#sa-threads-container').trigger('click.sa-unmake-active');
                $('.sa-active-thread').removeClass('sa-active-thread');
                var threadWrap = thread.closest('.sa-thread-wrapper');
                threadWrap.addClass('sa-active-thread');
            }
        },

        makeThreadActive: function (thread) {
            FVI.unmakeThreadActive();
            thread.closest('.sa-thread-wrapper').addClass('sa-active-thread');
        },

        unmakeThreadActiveByEvent: function (e) {
            if ($(e.target).attr("id") === 'sa-threads-container') {
                FVI.unmakeThreadActive();
            }
        },

        unmakeThreadActive: function () {
            var thread = $('.sa-active-thread');
            FVI.hideReplyControlsByThread(thread, false);
            thread.removeClass('sa-active-thread');
        },

        drawThreadPreviews: function () {
            $('#sa-threads-container').find('.sa-thread-wrapper').each(function () {
                var allComments = $(this).find('.sa-comment');
                var firstComment = allComments.first();

                var previewContainer = $(this).find('.sa-thread-preview');
                var authorHtml = firstComment.find('.sa-comment-author').html();
                var content = escapeHtml(firstComment.find('.sa-comment-body').text());
                content = content.trim().length === 0 ? "..." : content;

                previewContainer.find('.sa-thread-preview-avatar').empty().append(authorHtml);
                previewContainer.find('.sa-thread-preview-content').empty().append(content);
                previewContainer.find('.sa-thread-preview-badge .aui-badge').empty().append(allComments.length);
            });
        },

        initRevisionsDialog: function (ids, currentAttachId) {
            var container = $('#sa-file-revisions-container');
            $('#inline-dialog-sa-file-revision-dialog').remove();

            var attachments = [];

            $.each(ids, function (i, elem) {
                var attachment = FVI.getAttachmentWithClassRevision(AttachCat.getItemById(elem));
                var attachmentLink = attachment.find('a[file-preview-id]');
                var $aLinkTitle = $(attachment.find('.attachment-title a, a.attachment-title').get(0));

                attachments.unshift({
                    'id': attachmentLink.length ? attachmentLink.attr('file-preview-id') : elem,
                    'title': attachmentLink.length ? attachmentLink.attr('file-preview-title') : $aLinkTitle.text(),
                    'version': i + 1,
                    'active': currentAttachId === elem,
                    'fakeFV': attachmentLink.length === 0
                });
            });

            container.empty().append(FVITemplates.listRevisions({'attachments': attachments}));

            AJS.InlineDialog($("#sa-file-revisions"), "sa-file-revision-dialog",
                function (content, trigger, showPopup) {
                    content.html($(container).html());
                    showPopup();
                    return false;
                },
                {
                    offsetX: -1,
                    offsetY: 0
                }
            );
        },

        changeFileRevision: function () {
            var isFakeFV = $(this).attr('is-fake-fv') === "true";
            FVI.closeAllFileViewers();

            if (FVI.isFVEnabled() && !isFakeFV) {
                try {
                    var fileViewer = require('jira/fileviewer');
                    if (fileViewer !== undefined) {
                        fileViewer.addDocumentSelector('.sa-revision-item');
                        fileViewer.attachToElements($('#sa-file-revisions-container'));
