                    data: {
                        projectKey: this.getProjectKey
                    },
                    success: function (data) {
                        $field.attr('checked', data === 'true');
                        result.resolve(this);
                    }
                });
                return result;
            }
        });

        return SADialogEmail;
    });
}catch(e){WRMCB(e)};
