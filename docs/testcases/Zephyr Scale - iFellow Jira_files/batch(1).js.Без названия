RLABS.Ajax.handleGlobalErrors = function(res, onGlobalError) {

  // see if we have something to work with.
  if (!res.hasGlobalErrors()) return false;

  // display errors with an AUI message
  RLABS.Notification.showErrors({ errors : res.getGlobalErrors()});

  if(onGlobalError && (onGlobalError instanceof Function))
  {
    onGlobalError(res);
  }

  return true;
};

