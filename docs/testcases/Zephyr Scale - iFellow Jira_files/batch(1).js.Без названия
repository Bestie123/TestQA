            draw: function (data) {
                var itemAttachmentsSection = this.getAttachmentsSection().find('.item-attachments');
                var containerId = itemAttachmentsSection.attr('id');
                console.log('Container id: ' + containerId);
                var originalAttachmentItems = itemAttachmentsSection.find('.attachment-content');

                this.addDialogDeleteClass(originalAttachmentItems);

                this.categories.forEach(function (category) {
                    var ids = this.getDocumentAttachmentIdsFromDataCategory(category);
                    ids.forEach(function (id) {
                        if (category.attachmentIds.indexOf(id) === -1) {
                            category.attachmentIds.push(id);
                        }
                    });
                }.bind(this));
                //sort items by category
                var reducer = mapToCategoryReducer(this.categories, data.attachmentsWithComments, data.attachmentsInPublicComments);
                var mapToCategory = originalAttachmentItems.toArray().reduce(reducer, []);

                var needCollapse = function (category) {
                    return data.collapsedCategories.indexOf(category.id) > -1;
                };
                // file_attachments - list
                // attachment_thumbnails - thumbnails
                this.categories.forEach(function (category, position) {
                    var categoryId = category.id;
                    var attachmentElements = mapToCategory[categoryId];
                    var catContainer = new AttachmentCategory({
                        position: position,
                        issue: this.issue,
                        category: category,
                        categories: this.categories,
                        pluginConfig: data,
                        baseUrl: window.AJS.params.baseURL,
                        isJSDForm: this.isServiceDesk,
                        isAgile: this.isAgile,
                        attachmentElements: attachmentElements,
                        viewMode: containerId === 'attachment_thumbnails' ? 'thumbnails' : 'list',
                        attachmentAuthors: data.attachmentAuthors,
                        currentAuthor: data.currentAuthor,
                    });

                    catContainer.bind('attachment:prepareForRevision', this.prepareForRevision(catContainer).bind(this));
                    catContainer.bind('attachment:prepareForUpload', this.prepareForUploadToCategory(catContainer).bind(this));
                    catContainer.bind('attachment:remove', this.onAttachmentRemove.bind(this));
                    catContainer.bind('attachment:move', this.onAttachmentMove.bind(this));
                    catContainer.bind('category:position', this.onCategoryMove.bind(this));

                    if (needCollapse(category)) {
                        catContainer.collapse();
                    }

                    this.categoryContainers.push(catContainer);
                    this.categoriesContainerNode.append(catContainer.render());
                    catContainer.attachHandlers();
                }.bind(this));

                if (!data.hasCreatePermission) {
                    this.categorySection.addClass('not-editable')
                }

                this.$node.find('#attach-cat-help').remove();
                var $help = $(window.AttachCategory.help());
                this.$node.find('.mod-header').append($help);
                this.bindYouTubeDialog();

                this.hideRestrictedAttachments(originalAttachmentItems);

                var classes;
                if (data.previewSize > 200) {

                    var str = data.previewSize.toString();
                    var width = parseInt(str.slice(0, str.length / 2));
                    var height = parseInt(str.slice(str.length / 2, str.length));

                    classes = {
                        containerHeight: (height + 42) + "px",
                        height: (height) + "px",
                        width: (width) + "px",
                        top: (-51 - height) + "px",
                        iconMargin: height > 80 ? "-40px" : (-height / 2) + "px",
                        fontSize: height > 80 ? "80px" : height + "px"
                    };
                } else {
                    classes = {
                        containerHeight: (data.previewSize + 42) + "px",
                        height: (data.previewSize) + "px",
                        width: (data.previewSize) + "px",
                        top: (-51 - data.previewSize) + "px",
                        iconMargin: data.previewSize > 80 ? "-40px" : (-data.previewSize / 2) + "px",
                        fontSize: data.previewSize > 80 ? "80px" : data.previewSize + "px"
                    };
                }
                this.categorySection.prepend(window.AttachCategory.classes(classes));
                console.log('Draw finished');
            },

            addDialogDeleteClass: function (originalAttachmentItems) {
                var customDeleteFormClass = "sa-form-delete-attachment-link";
                var links = "a.icon-delete, a.aui-iconfont-delete, .attachment-delete > a, a:has( > span.aui-iconfont-delete)";

                originalAttachmentItems.find(links).each(function (i, link) {
                    $(link).addClass(customDeleteFormClass);
                });
            },

            setBulkControls: function () {
                var bulkMenuItem = $(window.AttachCategory.bulkMenuOption());
                bulkMenuItem.find('a').on('click', this.onEnterBulkMode.bind(this));
                this.sectionOps.find('#attachment-manage-options').append(bulkMenuItem);

                if (!this.isEmpty()) {
                    bulkMenuItem.removeClass('hidden');
                }

                this.bind('attachment:change', function () {
                    console.log('change bulk status');
                    if (this.isEmpty()) {
                        bulkMenuItem.addClass('hidden');
                    } else {
                        bulkMenuItem.removeClass('hidden');
                    }
                }.bind(this));

                var bulk = window.AttachCategory.bulkOperations({
                    categories: this.categories,
                    attachmentsDeletable: this.categorySection.find('.icon-delete, .aui-iconfont-delete').length > 0,
                    categoriesAvailable: this.categoryContainers.length > 1,
                    hasCreatePermission: this.hasCreatePermission,
                    user: window.AJS.params.loggedInUser,
                    isAgile: this.isAgile
                });

                this.categorySection.append(bulk);
                if (this.categorySection.height() > 0.7 * $(window).height()) {
                    this.categorySection.prepend(bulk);
                }

                this.bulkForm = new BulkForm({
                    element: this.categorySection,
                    categories: this.categories,
                });

                this.bulkForm.bind('bulk:hide', function () {
                    bulkMenuItem.removeClass('hidden');
                    _.invoke(this.categoryContainers, 'enableDND');
                    _.invoke(this.categoryContainers, 'enableBulkSelect');
                }.bind(this));

                this.bulkForm.bind('bulk:show', function () {
                    bulkMenuItem.addClass('hidden');
                    _.invoke(this.categoryContainers, 'disableDND');
                }.bind(this));

                this.bulkForm.bind('bulk:delete', this.onBulkDelete.bind(this));
                this.bulkForm.bind('bulk:download', this.onBulkDownload.bind(this));
                this.bulkForm.bind('bulk:move', this.onBulkMove.bind(this));
                this.bulkForm.bind('bulk:send', this.onBulkSend.bind(this));
                this.bulkForm.bind('bulk:archive', this.onBulkArchiveToCategory.bind(this));
                this.bulkForm.bind('operation:change', this.obBulkOperationChange.bind(this));
            },

            setFVIDocuments: function () {
                if (!Toolbox.isFVIModuleEnabled()) {
                    return;
                }

                var documents = [];
                $.each(this.categories, function (i, category) {
                    documents = $.merge(documents, category.documents);
                });
                FVI.documents = documents;
            },

            obBulkOperationChange: function (event, operation) {
                console.log("Bulk operation changed to", operation);
                this.categoryContainers.forEach(function (categoryContainer) {
                    if (!categoryContainer.category.allowWrite) {
                        if (FORBIDDEN_BULK_OPERATIONS.indexOf(operation) > -1) {
                            categoryContainer.disableBulkSelect();
                        } else {
                            categoryContainer.enableBulkSelect();
                        }
                    }
                });
            },

            onEnterBulkMode: function (event) {
                event.preventDefault();
                event.stopPropagation();
                $(document).click();
                this.bulkForm.show();
                return false;
            },

            getSelectedAttachments: function () {
                return this.categoryContainers.reduce(function (result, container) {
                    return result.concat(container.getSelectedItems());
                }, []);
            },

            onBulkDelete: function () {
                console.log('Bulk delete');
                var ids = this.getSelectedAttachments().map(getAttachmentId);
                window.SmartAttachmentsAnalytics.event('bulkOperationAttachmentsDeleted', [ids.length]);
                Operations.deleteDocuments(this.issue.getIssueKey(), ids)
                    .then(function () {
                        this.categoryContainers.forEach(function (container) {
                            container.getSelectedItems().forEach(function (selectedItem) {
                                container.releaseElement(selectedItem, true);
                            });
                        });
                    }.bind(this))
                    .always(function () {
                        this.bulkForm.hide();
                    }.bind(this));
            },

            onBulkDownload: function () {
                var ids = this.getSelectedAttachments().map(getAttachmentId);
                window.SmartAttachmentsAnalytics.event('bulkOperationAttachmentsDownloaded', [ids.length]);
                Operations.downloadAttachments(this.issue.getIssueKey(), ids);
                this.bulkForm.hide();
            },

            onBulkMove: function (event, targetCategoryId) {
                console.log('Bulk move to category: ' + targetCategoryId);
                var containers = this.categoryContainers.filter(findNotCategoryContainer(targetCategoryId));
                var moveInfos = containers.reduce(moveInfosBySelectedAttachments, []);
                var ids = moveInfos.reduce(function (result, moveInfo) {
                    return result.concat(moveInfo.attachmentIds);
                }, []);
                var result;
                if (ids.length) {
                    window.SmartAttachmentsAnalytics.event('bulkOperationAttachmentsToCategoryMoved', [ids.length]);
                    var target = this.getCategoryContainer(targetCategoryId);
                    var issue = this.issue;
                    result = Operations.moveAttachment(this.issue.getIssueKey(), targetCategoryId, ids);
                    result.then(function () {
                        moveInfos.forEach(function (moveInfo) {
                            var source = moveInfo.source;
                            source.releaseElement(moveInfo.attachmentItem);
                            target.addAttachmentElement(moveInfo.attachmentItem.element, moveInfo);
                        });
                        Events.trigger('change:attachments', [issue]);
                    });
                } else {
                    result = $.Deferred();
                    result.resolve({});
                }
                result.always(this.bulkForm.hide.bind(this.bulkForm));
            },

            onBulkSend: function () {
                var selected = this.getSelectedAttachments();
                var sendToEmailDialog = new SendToEmailDialog({
                    issue: this.issue,
                    items: selected
                });
                this.bulkForm.hide();
                sendToEmailDialog.show();
            },

            onBulkArchiveToCategory: function (event, targetCategoryId, fileName) {
                console.log("Archive to category " + targetCategoryId + " with fileName: " + fileName);
                var moveInfos = this.categoryContainers.reduce(moveInfosBySelectedAttachments, []);
                var idGroup = moveInfos.reduce(function (result, moveInfo) {
                    if (moveInfo.isDocument) {
                        result.documents.push(moveInfo.documentId);
                    }
                    result.attachments = result.attachments.concat(moveInfo.attachmentIds);
                    return result;
                }, {documents: [], attachments: []});

                SmartAttachmentsAnalytics.event('bulkOperationAttachmentsArchived', [idGroup.attachments.length]);
                this.bulkForm.startSpinner();
                Operations.archiveToCategory(this.issue.getIssueKey(), fileName, targetCategoryId, idGroup.attachments, idGroup.documents)
                    .then(function () {
                        this.reloadView();
                        JIRA.Messages.showMsg("Attachments archived successfully", {
                            type: JIRA.Messages.Types.SUCCESS,
                            closeable: false,
                            timeout: 3
                        });
                    }.bind(this))
                    .fail(function () {
                        JIRA.Messages.showMsg("Failed to archive attachments: see logs for details", {
                            type: JIRA.Messages.Types.ERROR,
                            closeable: false,
                            timeout: 3
                        });
                    })
                    .always(function () {
                        this.bulkForm.stopSpinner();
                    }.bind(this));
            },

            onAssignToMeClick: function () {
                var hanlder = function () {
                    this.resetDropzone();
                    if (this.isAgile) {
                        GH.DetailsView.reload();
                    }
                }.bind(this);
                $(this.isAgile ? '#gh' : '#issue-content').off('click.sa-reset').on('click.sa-reset', 'a.issueaction-assign-to-me', hanlder);
            },

            bindFeedbackClickHandler: function () {
                console.info('bindFeedbackClickHandler');

                var feedbackClickHandler = function (e) {
                    if (!window.CCFeedbackWidget) {
                        return;
                    }

                    e.preventDefault();

                    var feedbackWidgetEvent;
                    if (window.CustomEvent) {
                        feedbackWidgetEvent = new CustomEvent('toggleFeedbackWidget');
                    } else {
                        feedbackWidgetEvent = document.createEvent('CustomEvent');
                        feedbackWidgetEvent.initCustomEvent('toggleFeedbackWidget', true, true);
                    }
                    document.dispatchEvent(feedbackWidgetEvent);
                };

                $(this.isAgile ? '#gh' : '#issue-content')
                    .off('click.sa-feedback')
                    .on('click.sa-feedback', '#attach-cat-feedback-button', feedbackClickHandler);
            },

            isEmpty: function () {
                return !this.categoryContainers.some(function (container) {
                    return !container.isEmpty();
                });
            },

            hideRestrictedAttachments: function (originalAttachmentItems) {
                var hrefs = [];
                var histVal = [];
                var ids = [];

                _.each(originalAttachmentItems, function (element) {
                    var item = $(element);
                    if (!item.data('attachmentId')) {
                        var id = getItemId(item);
                        if (id) {
                            ids.push();
                            item.remove();
                        }
                    }
                }, this);

                ids.forEach(function (id) {
                    hrefs.push('a[href*="/secure/attachment/' + id + '/"]');
                    histVal.push('span.hist-value:contains(' + id + ')');
                });

                if (hrefs.length) {
                    $('<style type="text/css">' + hrefs.join() + '{display: none;}</style>').appendTo("head");
                    $(hrefs.join()).parent('.activity-new-val').parent().remove();
                    $(histVal.join()).parent('.activity-old-val').parent().remove();
                    $(document).bind('DOMNodeInserted', function () {
                        $(hrefs.join()).parent('.activity-new-val').parent().remove();
                        $(histVal.join()).parent('.activity-old-val').parent().remove();
                    });
                }
            },

            bindEvents: function () {
                this.bindRemoveDocumentsFromDropdownWikiEditor();
                if (Toolbox.isFVIModuleEnabled()) {
                    FVI.init();
                }

                AsyncModule.onReady('goedit', this.bindGoEdit.bind(this));

                this.bindFeedbackClickHandler();
            },

            bindGoEdit: function () {
                console.log('Set handler for GoEdit file save');
                this.$document.off('goedit:file-saved').on('goedit:file-saved', function (e, params) {
                    var attachmentId = params[0].fileID;
                    var fileName = params[0].fileName;
                    var attachmentView;
                    this.categoryContainers.find(function (container) {
                        attachmentView = container.getAttachmentView(attachmentId);
                        return !!attachmentView;
                    });
                    if (attachmentView) {
                        var categoryId = attachmentView.category.id;
                        var documentId;

                        if (attachmentView.isDocument) {
                            documentId = attachmentView.getDocumentId();
                        }

                        var issue = this.issue;

                        JIRA.SmartAjax.makeRequest({
                            type: 'POST',
                            async: true,
                            url: AJS.params.baseURL + '/rest/attach-cat/1.0/attachments/goedit-integration/replace-move',
                            data: {
                                oldAttachId: attachmentId,
                                oldAttachName: fileName,
                                oldAttachCategoryId: categoryId,
                                isReplace: params[0].replace,
                                documentId: documentId,
                                parent: attachmentId,
                                issueKey: issue.getIssueKey()
                            },
                            success: _.partial(Toolbox.invalidateDataAndView, issue)
                        });
                        SmartAttachmentsAnalytics.event('attachmentWithGoEditEdited', [fileName]);
                    }
                }.bind(this));
