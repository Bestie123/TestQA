  var newUsername = RLABS.Ajax.getUserForResponse(xhr);

  // If there a situation where this isn't what the user wants and would
  // prefer to be prompted to either reload or log back in?
  if (originalUsername !== 'anonymous' && newUsername === 'anonymous') {
    // If the user has been logged out, redirect to the login page for them
    RLABS.log('User changed. original: ' + originalUsername + ' new: ' + newUsername + '. Redirecting to the login page');
    location.href = RLABS.Ajax.getLoginUrl();
  } else {
    // else the user has changed and therefore the pages state is inconsistent
    // Reload it to ensure we have a consistent state
    RLABS.log('User changed. original: ' + originalUsername + ' new: ' + newUsername + '. Reloading the page!!!');
    //location.reload();
  }

  return AJS.$.Deferred(); // Don't resolve or reject this. We don't want to invoke any of the callbacks
};

/**
 * This function returns a login url with a redirect pointer back to the current page
 */
RLABS.Ajax.getLoginUrl = function() {
  return RLABS.Ajax.CONTEXT_PATH + '/login.jsp?os_destination=' + encodeURIComponent(window.location.href);
};
