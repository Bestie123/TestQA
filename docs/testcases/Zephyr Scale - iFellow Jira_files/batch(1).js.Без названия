                $('#category-zone-container').remove();
                var $container = $('<div id="category-zone-container" class="zone-container"></div>');
                this.$node.append($container);
                var MARGIN = 10;
                var containerWidth = $container.width() - MARGIN;
                var containerHeight = $container.height() - MARGIN;
                var count = this.categories.length;
                var columns = Math.ceil(Math.sqrt(count));
                var rows = Math.ceil(count / columns);
                var heightItem = ((containerHeight / rows) * 100) / containerHeight;

                var categoriesContainer = $('<ul id="categories-drop-zones-container"></ul>');
                var sum = 0;

                for (var i = 0; i < rows; i++) {
                    var amountInRow = Math.ceil((count - sum) / (rows - i));
                    var widthItem = ((containerWidth / amountInRow) * 100) / containerWidth;

                    for (var j = 0; j < amountInRow; j++) {
                        var $dropZoneItem = this.createDropZoneItem(this.categories[sum + j], widthItem, heightItem);
                        this.borderItems.push($dropZoneItem.find('div.category-drop-zone-border')[0]);
                        categoriesContainer.append($dropZoneItem);
                    }
                    sum += amountInRow;
                }

                $container.append(categoriesContainer);
                return categoriesContainer;
            },

            decorateCategoryZone: function (target) {
                var activeItem = target.parentElement.querySelector('.category-drop-zone-border');
                _.each(this.borderItems, function (item) {
                    if (activeItem !== item) {
                        item.classList.remove('drag-hovered');
                    }
                });

                if (!activeItem.classList.contains('drag-hovered')) {
                    activeItem.classList.add('drag-hovered');
                    this.trigger('changeCategory', activeItem.parentElement.dataset['categoryId']);
                }
            },

            onDragOver: function (event) {
                event.stopPropagation();
                event.preventDefault();
                if (this.leaveDropZone) {
                    clearTimeout(this.leaveDropZone);
                }

                if (event.originalEvent) {
                    event.originalEvent.dataTransfer.dropEffect = "copy";
