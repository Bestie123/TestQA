                var resultCc = EmailChecker.testEmails(this.$ccInput.val());
                var resultBcc = EmailChecker.testEmails(this.$bccInput.val());

                if (resultTo.emailsCount === 0) {
                    $('#empty-to', form).show();
                } else if (!resultTo.success) {
                    $('#error-to', form).show();
                }

                if (!resultCc.success) {
                    $('#error-cc', form).show();
                }

                if (!resultBcc.success) {
                    $('#error-bcc', form).show();
                }

                var resultMessage = $.trim(this.$messageInput.val());
                if (!resultMessage) {
                    $('#empty-message', form).show();
                }

