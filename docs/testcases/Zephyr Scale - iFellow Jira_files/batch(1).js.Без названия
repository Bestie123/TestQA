                progressBar.find('.upload-progress-bar__bar').css('width', 100 * this.progress + '%');
            }
            if ((100 * this.progress) > 99) {
                progressBar.addClass('upload-progress-bar__progress-bar-finished');
            }
        },

        render: function () {
            this.$node = $(this.template({
                fileName: this.delegate.getFileName()
            }));
            this.$node.find('.cancel-action').on('click', function () {
                this.delegate.destroy();
