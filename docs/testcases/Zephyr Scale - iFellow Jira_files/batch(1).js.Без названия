"use strict";

AJS.namespace("com.deniz.jira.worklogpro");


/**
 * A single-select list for selecting Issues.
 *
 * @constructor JIRA.AdminHelper.IssuePicker
 * @extends AJS.SingleSelect
 */
window.WorklogPRO_projectId = "";

window.WorklogPRO_IssuePicker = AJS.SingleSelect.extend({
    init: function (options) {
        function formatResponse(response) {
            if (!response.sections) {
                return [];
            }
            var ret = [];
            AJS.$(response.sections).each(function (i, section) {
                var groupDescriptor = new AJS.GroupDescriptor({
                    weight: i,
                    label: section.label
                });
                AJS.$(section.issues).each(function (i, issue) {
                    groupDescriptor.addItem(new AJS.ItemDescriptor({
                        value: issue.key,
                        label: issue.key + " - " + issue.summaryText,
                        html: issue.keyHtml + " - " + issue.summary,
                        icon: AJS.contextPath() + issue.img,
                        title: issue.summaryText
                    }));
                });
                ret.push(groupDescriptor);
            });

            return ret;
        }

        AJS.$.extend(options, {
            errorMessage: "\u0417\u0410\u041f\u0420\u041e\u0421 \u041d\u0415 \u0421\u0423\u0429\u0415\u0421\u0422\u0412\u0423\u0415\u0422",
            submitInputVal: true,
            matchingStrategy: "(^|.*?(.*))({0})(.*)",
            ajaxOptions: {
                url: function() {
                    var queryPart = "";
                    if (window.WorklogPRO_queryType === "filters") {
                        queryPart = "&filterName=" + encodeURIComponent(window.WorklogPRO_filterName);
                    } else if (window.WorklogPRO_projectId.length > 0) {
                        queryPart = "&projectIdOrKey=" + encodeURIComponent(window.WorklogPRO_projectId);
                    }

                    return AJS.contextPath() + "/rest/com.deniz.jira.worklog/1.0/issues/picker?queryType=" + window.WorklogPRO_queryType + queryPart;
                },
                query: true,
                formatResponse: formatResponse
            }
        });
        this._super(options);
    }
});

}catch(e){WRMCB(e)};
;
