                event.preventDefault();
                this.leaveDropZone = setTimeout((function () {
                    this.trigger("leaveCategories")
                }).bind(this), 500);
            },

            getSelectedCategoryId: function () {
                return this.$node.find('.drag-hovered').closest('li').data('categoryId');
            }
        });
        return CategoryZones;
    });
