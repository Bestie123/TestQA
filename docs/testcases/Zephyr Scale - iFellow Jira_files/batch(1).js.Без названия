        },

        changeScale: function (scale, $el, $image, imageDimensions) {
            var viewportWidth = $el.width();
            var viewportHeight = $el.height();
            var oldWidth = $image.width();
            var oldHeight = $image.height();
            var containerPosition = $el.find(".cp-image-container").position();

            //find the position of the pixel in the centre of the viewport
            var oldPixelCentreWidth = (viewportWidth / 2) + Math.abs(containerPosition.left);
            var oldPixelCentreHeight = (viewportHeight / 2) + Math.abs(containerPosition.top);

            $image.css("width", imageDimensions.imageWidth * scale);
            $image.css("height", imageDimensions.imageHeight * scale);

            //calculate the new pixel centre after the image has been scaled
            var newPixelCentreWidth = (oldPixelCentreWidth / oldWidth) * $image.width();
            var newPixelCentreHeight = (oldPixelCentreHeight / oldHeight) * $image.height();

            //move the scrollbar to the new pixel and then center the viewport on it
            $el.scrollLeft(newPixelCentreWidth - (viewportWidth / 2));
            $el.scrollTop(newPixelCentreHeight - (viewportHeight / 2));

            if (($el.width() < $image.width()) || ($el.height() < $image.height())) {
                $image.addClass("pannable");
            } else {
                $image.removeClass("pannable");
            }

