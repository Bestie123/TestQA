                        e.preventDefault();
                        e.stopPropagation();
                    }

                    // Enter
                    if (e.which == 13) {
                        $('.smart-attach-suggestion-active').find('.smart-attach-suggestion').click();
                    }

                    // Escape
                    if (e.which == 27) {
                        $suggestions.remove();
                    }

                    // Up
                    if (e.which == 38) {
                        var $prev = $('.smart-attach-suggestion-active').removeClass('smart-attach-suggestion-active').prev('li');
                        if ($prev.length == 0) {
                            $prev = $suggestions.find("li:last");
                        }
                        $prev.addClass("smart-attach-suggestion-active");
                    }

                    // Down
                    if (e.which == 40) {
                        var $next = $('.smart-attach-suggestion-active').removeClass('smart-attach-suggestion-active').next('li');
                        if ($next.length == 0) {
                            $next = $suggestions.find("li:first");
                        }
                        $next.addClass("smart-attach-suggestion-active");
                    }
                }
            });
