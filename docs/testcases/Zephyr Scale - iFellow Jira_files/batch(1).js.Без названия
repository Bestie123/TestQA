                }));
            }
            AJS.$(response.users).each(function(i, user) {
                var emailAddress = user.emailAddress;
                var label = user.displayName;
                var username = user.name;
                if (emailAddress) {
                    label += ' - ' + emailAddress;
                }
                label += ' (' + username + ')';

