        };

        var SADialogEmail = Class.extend({
            init: function (opts) {
                _.extend(this, opts);
                this.projectKey = Toolbox.getProjectKey(this.issue.getIssueKey());
                this.createDialog();
            },

            createDialog: function () {
                var attachments = this.items.map(function (attachmentItem) {
                    return {
                        id: attachmentItem.getItemId(),
                        name: attachmentItem.attachmentName
                    }
                });

                var body = $(AttachCategory.mailDialog({
                    attachments: attachments,
                    issueKey: this.issue.getIssueKey(),
                    issueSummary: $('#summary-val').text()
                }));

                var emailDialog = new AJS.Dialog(DIALOG_CONFIG);

                emailDialog.addHeader("Send email");
                emailDialog.addPanel('panel', body, 'mail-attach-dialog-panel');
                emailDialog.addButton("Send", this.onSend.bind(this), 'send-attach-email');
                emailDialog.addLink("Cancel", function (dialog) {
                    dialog.remove();
                }, '#');

                this.$subjectInput = body.find('#subject');
                this.$messageInput = body.find('#message');
                this.$putToComments = body.find('#putEmailToComments');
                this.$putToComments.on('change', this.storeCheckboxStateOfCommenting.bind(this));
                this.$toInput = body.find('#to');
                this.$ccInput = body.find('#cc');
                this.$bccInput = body.find('#bcc');
                _.each([this.$toInput, this.$ccInput, this.$bccInput], SmartAttachAutocomplete.init.bind(SmartAttachAutocomplete));
                this.$body = body;
                this.dialog = emailDialog;
            },

