                if (skipDialogs.indexOf(dialogId) < 0) {
                    console.log("Need decorate " + dialog.options.id);
                    var uploadInfo = {
                        issue: this.issue,
                        revisionMatcher: Revisions.createFilesMatcher(this.revisionMatcher.bind(this))
                    };
                    var decorator = void 0;
                    if (nonDropZoneDialog.indexOf(dialogId) > -1) {
                        uploadInfo.categories = this.categories;
                        decorator = new CtrlVDialogDecorator({
                            dialog: dialog,
                            uploadInfo: uploadInfo
                        });
                    } else {
                        decorator = new AttachFilesDecorator({
                            dialog: dialog,
                            uploadInfo: uploadInfo
                        });
                    }
                    if (decorator && dialogId!=="edit-issue-dialog") {
                        this.onDecorateSuccess(decorator);
                    }
                }
            },

            onDialogReady: function (callback, isFake) {
                var result = $.Deferred();
                var handler = function (event, dialog) {
                    var decorator = callback.call(this, dialog);
                    if (decorator) {
                        result.resolve(decorator);
                    }
                };
                this.$document.one('dialogContentReady' + (isFake ? "-fake" : ""), handler.bind(this));
                return result;
            },

            prepareForRevision: function (categoryContainer) {
                return function (event, versionInfo) {
                    console.log('prepare for version upload');
                    var attachmentInfos = this.categoryContainers.reduce(function (collector, container) {
                        var infos = _.filter(container.getAttachmentInfo(), function (info) {
                            return info.id !== versionInfo.callerAttachId;
                        });

                        if (infos.length) {
                            collector.push({
                                category: container.category,
                                files: infos
                            });
                        }
                        return collector;
                    }, []);

                    var versioning = {
                        info: versionInfo,
                        container: categoryContainer,
                        attachmentInfos: attachmentInfos
                    };

                    var ctx = this;

                    this.onDialogReady(function (dialog) {
                        console.log('Version dialog content ready');
                        return new VersionDialogDecorator({
                            dialog: dialog,
                            issue: ctx.issue,
                            versioning: versioning,
                            isAgile: ctx.isAgile
                        });
                    }).then(this.onDecorateSuccess.bind(this));
                };
            },

            prepareForUploadToCategory: function (categoryContainer) {
                return function (event, category, issue) {
                    console.group('prepare for file upload');
                    var uploadInfo = {
                        container: categoryContainer,
                        category: category,
                        issue: issue,
                        revisionMatcher: Revisions.createFilesMatcher(this.revisionMatcher.bind(this))
                    };
                    if (this.isServiceDesk) {
                        console.log('isServiceDesk');
                        sessionStorage.setItem('invokedFromCategory', category.id);
                        this.onDialogReady(function (dialog) {
                            new SDAttachFileDecorator({
                                dialog: dialog,
                                uploadInfo: uploadInfo
                            });
                        }, true);
                    } else {
                        console.log('isOrdinal');
                        this.onDialogReady(function (dialog) {
                            return new AttachFileDecorator({
                                dialog: dialog,
                                uploadInfo: uploadInfo
                            });
                        }).then(this.onDecorateSuccess.bind(this));
                    }
                    console.groupEnd();
                }.bind(this);
            },

            prepareForUploadFiles: function () {
                console.log('prepare for files upload');
                var uploadInfo = {
                    categories: this.categories,
                    issue: this.issue,
                    revisionMatcher: Revisions.createFilesMatcher(this.revisionMatcher.bind(this))
                };

                this.onDialogReady(function (dialog) {
                    return new AttachFilesDecorator({
                        dialog: dialog,
                        uploadInfo: uploadInfo
                    });
                }).then(this.onDecorateSuccess.bind(this));
            },

            onDecorateSuccess: function (decorator) {
                decorator.bind('submit:success', function () {
                    this.reloadView();
                }.bind(this));
            },

            revisionMatcher: function (categoryId, fileName) {
                console.log('Try match file to another attachment in category ' + categoryId);
                var categoryContainer = this.getCategoryContainer(categoryId);
                return categoryContainer.findAttachmentForRevision(fileName);
            },

            reloadView: function () {
                Toolbox.invalidateDataAndView(this.issue);
            },

            onAttachmentRemove: function (event, container, itemView) {
                this.trigger('attachment:change');
                if (itemView.isRevision) {
                    if (itemView.owner && itemView.owner.revisions.length < 2) {
                        this.reloadView();
                        return;
                    }
                }
                Events.trigger('change:attachments', [this.issue]);
            },

            onAttachmentMove: function (event, attachmentId, sourceCategoryId, targetCategoryId) {
                var source = this.getCategoryContainer(sourceCategoryId);
                var target = this.getCategoryContainer(targetCategoryId);
                if (!source || !target) {
                    return;
                }

                var attachmentView = source.getAttachmentView(attachmentId);
                if (!attachmentView) {
                    return;
                }

                var moveInfo = attachmentView.getMoveInfo();

                window.SmartAttachmentsAnalytics.event('attachmentToCategoryMoved', [moveInfo.attachmentItem.attachmentName]);

                var result = Operations.moveAttachment(this.issue.getIssueKey(), targetCategoryId, moveInfo.attachmentIds);
                result.then(function () {
                    source.releaseElement(moveInfo.attachmentItem);
                    target.addAttachmentElement(moveInfo.attachmentItem.element, moveInfo);
                });
            },

            onCategoryMove: function (event, position, sourceCategoryId) {
                console.log("Put category " + sourceCategoryId + " at position " + position);
                var source = this.getCategoryContainer(sourceCategoryId);
                var left = this.categoryContainers.slice(0, position);
                var right = this.categoryContainers.slice(position);
                var isCategoryNotMatch = function (container) {
                    return container.category.id !== sourceCategoryId;
                };
                if (source.position < position) {
                    left = _.filter(left, isCategoryNotMatch);
                } else {
                    right = _.filter(right, isCategoryNotMatch);
                }

                left.push(source);
                var result = left.concat(right);
                result.forEach(function (container, position) {
                    container.position = position;
                });
                if (left.length > 1) {
                    source.$node.insertAfter(left[left.length - 2].$node);
                } else {
                    right[0].$node.before(source.$node);
                }
                this.categoryContainers = result;
                Operations.saveCategoriesPosition(this.getProjectKey(), this.getIdsPositionsOfCategories());
            },

            onNewContentAdded: function (event, $ctx, reason) {
                if (reason === Reasons.panelRefreshed) {
                    var categories = this.categories;
                    var isKnownAttachment = function (attachmentId) {
                        return _.some(categories, function (category) {
                            return category.attachmentIds.indexOf(attachmentId) > -1;
                        });
                    };

                    if ($ctx) {
                        if ($ctx.attr('id') === 'attachmentmodule') {
                            // Agile board требует особого внимания =)
                            if (this.isAgile) {
                                $ctx.hide();
                            }
                        }

                        if ($ctx.hasClass('item-attachments')) {
                            console.log('Panel refreshed');
                            var attachmentElements = this.getAttachmentsSection().find('.item-attachments .attachment-content');
                            var attachmentChanges = false;
                            _.each(attachmentElements, function (item) {
                                var attachmentId = getItemId($(item));
                                if (attachmentId && !isKnownAttachment(attachmentId)) {
                                    item.dataset['attachmentId'] = attachmentId;
                                    var categoryContainer = this.categoryContainers.find(findCategoryContainerWithAttchmentId(attachmentId));
                                    if (categoryContainer) {
                                        categoryContainer.addAttachmentElement(item);
                                        attachmentChanges = true;
                                        this.trackAnalyticsAttachmentUpload(categoryContainer, item);
                                    }
                                }
                            }.bind(this));
                            if (attachmentChanges) {
                                this.trigger('attachment:change');
                            }
                        }
                    }
                }

                if (reason === Reasons.inlineEditStarted) {
                    if ($ctx) {
                        var fieldId = $ctx.attr('id');
                        if (fieldId === 'type-val' || fieldId === 'assignee-val') {
                            var inlineEditForm = $ctx.find('form');
                            if (fieldId === 'assignee-val' && this.isAgile) {
                                var destroyView = function () {
                                    this.$node.find('.ops').empty();
                                    this.$node.find('.attach-cat-bulk-container').remove();
                                    this.$node.find('#attach-cat-categories').empty().append('<div id="not-initialized"></div>');
                                    Events.trigger('change:sectionView', [this.issue]);
                                }.bind(this);
                                inlineEditForm.one('before-submit', destroyView);
                            }

                            inlineEditForm.one('before-submit', this.resetDropzone.bind(this));
                        }
                    }
                }
            },

            resetDropzone: function () {
                console.log('Reset dropzone');
                var attachmentDropzone = this.getAttachmentsSection();
                var content = attachmentDropzone.find('.mod-content');
                if (content.length) {
                    content.removeClass('issue-drop-zone');
                    content.find('div.issue-drop-zone').remove();
                }
                Events.trigger('change:attachments', [this.issue]);
                return true;
            },

