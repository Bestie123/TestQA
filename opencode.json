{
  "$schema": "https://opencode.ai/config.json",
  "command": {
    "push": {
      "description": "Закоммитить все изменения и отправить на GitHub",
      "template": "Выполни git add -A, затем git commit с автоматическим сообщением (на основе списка изменённых файлов), и git push. Если есть незакоммиченные изменения —.commit их. Если возникнет ошибка аутентификации — используй GitHub CLI: gh auth login"
    }
  },
  "mcp": {
    "browser-devtools": {
      "type": "local",
      "command": ["node", "Q:\\User_Data\\Desktop\\TestQA\\qtest-runner\\mcp-servers\\browser-devtools\\server.js"],
      "enabled": true
    },
    "zephyr-scale": {
      "type": "local",
      "command": ["node", "Q:\\User_Data\\Desktop\\TestQA\\qtest-runner\\mcp-servers\\zephyr-scale\\server.js"],
      "enabled": true
    },
    "postman": {
      "type": "local",
      "command": ["npx", "-y", "@postman/postman-mcp-server"],
      "enabled": true,
      "environment": {
        "POSTMAN_API_KEY": "POSTMAN-KEY-REMOVED"
      }
    },
    "wiki-search": {
      "type": "local",
      "command": ["node", "Q:\\User_Data\\Desktop\\TestQA\\qtest-runner\\mcp-servers\\wiki-search\\server.js"],
      "enabled": true
    },
    "mcp-browser": {
      "type": "local",
      "command": ["node", "Q:\\User_Data\\Desktop\\TestQA\\qtest-runner\\packages\\mcp-browser\\dist\\index.js"],
      "cwd": "Q:\\User_Data\\Desktop\\TestQA\\qtest-runner\\packages\\mcp-browser",
      "enabled": true
    }
  }
}
